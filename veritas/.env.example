# Veritas service configuration.
# Copy this file to `.env` and edit. NEVER commit a real `.env` — no secrets in code.
# All settings are read from environment variables prefixed with VERITAS_.

# Postgres connection string (psycopg v3 format).
VERITAS_DATABASE_URL=postgresql://localhost/veritas

# Root directory for the local encrypted object store (StorageBackend).
# The service creates it on boot if missing.
VERITAS_STORAGE_ROOT=./data/objects

# DEV-ONLY master key for envelope encryption (base64 of 32 bytes).
# Replace with a freshly generated key for any shared/staging/prod deployment:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# The pipeline refuses to start storage operations without a valid 32-byte key.
VERITAS_MASTER_KEY=gk9vd9gGU/lvdzrvpAr2U7f8DQ205Hj8nV7jVrpaaM4=

# Runtime environment: dev | staging | prod
VERITAS_ENVIRONMENT=dev

# Upload hard cap (bytes) — architecture §6.2, aligns with §13 Q4 (50–100 MB audits).
VERITAS_UPLOAD_MAX_BYTES=104857600
# Retention default for uploads (days) — §10.4; timestamp set at insert time.
VERITAS_RETENTION_DAYS=30
# Parse-safety gate (§6.2): sandboxed subprocess limits (memory MB, CPU seconds,
# probe row cap). A file that over-runs either limit is quarantined.
VERITAS_PARSE_MEMORY_LIMIT_MB=1536
VERITAS_PARSE_CPU_SECONDS=60
VERITAS_PARSE_ROW_CAP=100000
# -------------------------------------------------------------------------------
# Phase 0.6 cost gate (§11.3) — deterministic token budgets (no provider at MVP,
# so the gate never spends money). When a provider + price are configured
# (Phase 1), the same machinery extends to USD.
# -------------------------------------------------------------------------------
# Master switch for the cost gate.
VERITAS_COST_GATE_ENABLED=true
# Per-audit hard token budgets.
VERITAS_COST_GATE_MAX_TOKENS_IN=250000
VERITAS_COST_GATE_MAX_TOKENS_OUT=75000
# Pre-run estimate knobs: est_in = rows*tokens_per_row + size*tokens_per_byte
# + judgment_rules*tokens_per_judgment_rule (times safety factor); est_out =
# judgment_rules*tokens_out_per_judgment_rule (times safety factor).
VERITAS_COST_GATE_ESTIMATE_TOKENS_PER_BYTE=0.5
VERITAS_COST_GATE_ESTIMATE_TOKENS_PER_ROW=40
VERITAS_COST_GATE_ESTIMATE_TOKENS_PER_JUDGMENT_RULE=300
VERITAS_COST_GATE_ESTIMATE_TOKENS_OUT_PER_JUDGMENT_RULE=100
VERITAS_COST_GATE_ESTIMATE_BYTES_PER_ROW=200
VERITAS_COST_GATE_ESTIMATE_ROW_CAP=1000000
VERITAS_COST_GATE_ESTIMATE_SAFETY_FACTOR=1.25
# Monthly aggregate cap (§11.3c): 80% -> owner warning, 100% -> new audits queue
# for the owner review queue.
VERITAS_COST_GATE_MONTHLY_TOKENS_IN=2000000
VERITAS_COST_GATE_MONTHLY_TOKENS_OUT=600000
VERITAS_COST_GATE_MONTHLY_WARN_RATIO=0.80
VERITAS_COST_GATE_MONTHLY_CAP_RATIO=0.20
# Dollar extension (Phase 1): when BOTH monthly revenue and a provider price are
# set, the monthly token caps derive from 20% of monthly revenue instead.
VERITAS_MONTHLY_REVENUE_USD=0
VERITAS_COST_GATE_PRICE_PER_MILLION_IN=0
VERITAS_COST_GATE_PRICE_PER_MILLION_OUT=0
# -------------------------------------------------------------------------------
# Phase 0.6 operations (§13 Q2) — see ops/README.md for full DR walk.
# -------------------------------------------------------------------------------
# Backup script defaults.
VERITAS_BACKUP_DIR=./data/backups
VERITAS_KEEP_BACKUPS=7
# Watchdog defaults.
VERITAS_HEALTH_URL=http://127.0.0.1:3000/health
VERITAS_ALERT_LOG=/var/log/veritas-watchdog.log
VERITAS_WATCH_INTERVAL=10
VERITAS_MAX_FAILS=3
